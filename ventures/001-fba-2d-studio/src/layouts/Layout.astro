---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Amazon FBA 2D Box Content Barcode & 4x6 SKU Margin-Stamping Thermal Studio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg: #09090b;
        --surface: #121215;
        --surface-hover: #18181b;
        --surface-card: #0d0d10;
        --border: #27272a;
        --border-focus: #3f3f46;
        --border-highlight: #52525b;
        --text-primary: #fafafa;
        --text-secondary: #a1a1aa;
        --text-subtle: #71717a;
        --accent-emerald: #10b981;
        --accent-amber: #f59e0b;
        --accent-rose: #f43f5e;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 13px;
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .tabular-nums {
        font-variant-numeric: tabular-nums;
      }

      /* Buttons & Controls */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.5rem 0.85rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.12s ease;
        border: 1px solid transparent;
        white-space: nowrap;
      }

      .btn-primary {
        background: #fafafa;
        color: #09090b;
        border-color: #fafafa;
        font-weight: 600;
      }
      .btn-primary:hover {
        background: #e4e4e7;
        border-color: #e4e4e7;
      }

      .btn-secondary {
        background: var(--surface);
        color: var(--text-primary);
        border-color: var(--border);
      }
      .btn-secondary:hover {
        background: var(--surface-hover);
        border-color: var(--border-focus);
      }

      .btn-pro {
        background: #064e3b;
        color: #34d399;
        border-color: #059669;
        font-weight: 600;
      }
      .btn-pro:hover {
        background: #047857;
        color: #ffffff;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        border: 1px solid var(--border);
      }
      .badge-emerald {
        background: #064e3b;
        color: #34d399;
        border-color: #059669;
      }
      .badge-amber {
        background: #78350f;
        color: #fcd34d;
        border-color: #d97706;
      }
      .badge-rose {
        background: #881337;
        color: #fda4af;
        border-color: #e11d48;
      }

      /* Global App Header */
      header {
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .header-inner {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand-title {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .brand-title span.slash {
        color: var(--text-subtle);
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 1rem 1.25rem;
        margin-top: auto;
        background: var(--surface-card);
      }
      .footer-inner {
        max-width: 1600px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-subtle);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="brand-title">
          <span>AMAZON FBA 2D BARCODE STUDIO</span>
          <span class="slash">/</span>
          <span style="color: var(--text-secondary); font-weight: 400; font-size: 0.75rem;">AMZN,PO: COMPLIANT</span>
        </a>

        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <span class="badge badge-emerald">
            <span>●</span> $0.15/UNIT FEE WAIVED
          </span>
          <span class="badge" style="color: var(--text-subtle);">
            CLIENT-SIDE WASM / ZERO SERVER LEAK
          </span>
          <a href="/#pro-pass" class="btn btn-pro" style="font-size: 0.72rem; padding: 0.25rem 0.65rem;">
            Pro Unlimited ($29)
          </a>
        </div>
      </div>
    </header>

    <main style="flex: 1; display: flex; flex-direction: column;">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div>
          Deterministic Amazon FBA 2D Box Content (`AMZN,PO:`) Barcode &amp; Margin-Stamping Engine &bull; ISO/IEC 15438 &amp; 16022 Standard
        </div>
        <div>
          Zero Backend Compute &bull; 100% Client-Side In-Memory Execution
        </div>
      </div>
    </footer>
  </body>
</html>
