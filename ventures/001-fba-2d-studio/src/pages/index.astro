---
import Layout from '../layouts/Layout.astro';
import specs from '../../data/deterministic_specs.json';
---

<Layout 
  title="Amazon FBA 2D Box Content Barcode & 4x6 SKU Margin-Stamping Thermal Studio"
  description="Client-side Amazon FBA 2D box content barcode generator (PDF417 & Data Matrix) and 4x6 thermal label margin-stamping studio. 100% deterministic browser engine."
>
  <div style="max-width: 1600px; margin: 0 auto; padding: 2rem 1.25rem; width: 100%;">
    
    <!-- HERO HEADER -->
    <div style="border-bottom: 1px solid var(--border); padding-bottom: 2rem; margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="badge badge-emerald">AMZN,PO: DETERMINISTIC ENGINE</span>
        <span class="badge" style="color: var(--text-subtle);">ISO/IEC 15438 & 16022</span>
      </div>

      <h1 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.75rem; color: #fff; font-family: var(--font-sans);">
        Amazon FBA 2D Box Content Barcode &amp; Margin-Stamping Studio
      </h1>

      <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 780px; line-height: 1.6; font-family: var(--font-sans); margin-bottom: 1.5rem;">
        Eliminate Amazon’s $0.15/unit manual box processing fee with deterministic, client-side 2D barcode generation. Instant 4x6" thermal printable box labels with scannable PDF417 / Data Matrix symbology, unit margin calculations, and FNSKU Code128 barcodes.
      </p>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href={`/tools/${specs[0].slug}`} class="btn btn-primary" style="font-size: 0.85rem; padding: 0.65rem 1.25rem;">
          Launch Live Studio (US Electronics) &rarr;
        </a>
        <a href="#marketplace-directory" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.65rem 1.25rem;">
          Browse 50 Deterministic Presets &darr;
        </a>
      </div>
    </div>

    <!-- METRICS BENCHMARK -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">
      <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.25rem; border-radius: 4px;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle); margin-bottom: 0.35rem;">AMAZON FBA FEE AVOIDED</div>
        <div style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: var(--accent-emerald);">$0.15 / Unit</div>
        <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.35rem;">$150 saved per 1,000 units shipped</div>
      </div>

      <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.25rem; border-radius: 4px;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle); margin-bottom: 0.35rem;">BARCODE ENGINE STANDARD</div>
        <div style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: #fff;">PDF417 &amp; Data Matrix</div>
        <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.35rem;">100% compliant with Seller Central specs</div>
      </div>

      <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.25rem; border-radius: 4px;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle); margin-bottom: 0.35rem;">COMPUTE ARCHITECTURE</div>
        <div style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: #fff;">$0 Backend Leak</div>
        <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.35rem;">All barcodes &amp; PDFs compile in-browser</div>
      </div>
    </div>

    <!-- 50 DETERMINISTIC ROUTES DIRECTORY -->
    <div id="marketplace-directory">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <h2 style="font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; color: #fff;">
          50 MARKETPLACE &amp; CATEGORY PRESETS
        </h2>
        <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle);">
          5 REGIONS &bull; 10 VERTICALS
        </span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0.75rem;">
        {specs.map((s) => (
          <a href={`/tools/${s.slug}`} style="background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 0.85rem 1rem; display: block; transition: all 0.12s ease;" class="preset-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
              <span class="badge" style="font-size: 0.65rem;">{s.marketplace}</span>
              <span class="badge badge-emerald" style="font-size: 0.65rem;">{s.barcode_format}</span>
            </div>
            <div style="font-size: 0.82rem; font-weight: 600; color: #fff; margin-bottom: 0.25rem; line-height: 1.3;">
              {s.category} 2D Box Content Studio
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-subtle);">
              Target Margin: {s.target_margin} &bull; {s.fee_avoided}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .preset-card:hover {
      border-color: var(--border-focus);
      background: var(--surface-hover);
    }
  </style>
</Layout>
